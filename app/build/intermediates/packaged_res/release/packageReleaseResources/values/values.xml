<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand_blue">#2156B5</color>
    <color name="brand_cream">#FFFBF2</color>
    <color name="brand_star">#FFC44D</color>
    <string name="app_name">VCCAprender</string>
    <style name="Theme.VCCAprender" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@color/brand_blue</item>
        <item name="android:navigationBarColor">@color/brand_cream</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/brand_cream</item>
    </style>
    <style name="Theme.VCCAprender.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VCCAprender</item>
    </style>
</resources>